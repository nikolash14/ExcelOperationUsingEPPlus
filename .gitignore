# =========================================================================
# .NET Core / .NET / C# Standard gitignore
# =========================================================================

# Target directories (Build outputs)
bin/
obj/
out/

# Roslyn cache directories
.tlog/
.cache/

# User-specific files (Visual Studio settings)
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# JetBrains Rider / Resharper
.idea/
*.sln.iml

# OmniSharp (VS Code C# Extension)
.omnisharp/

# Visual Studio Code settings
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Packaging / NuGet
*.nupkg
# NuGet packages folder (uncomment if you don't use global package cache)
# packages/

# Project crash logs / Crash dumps
*.stackdump
AppPackages/
BundleArtifacts/

# Local Environment Secrets 
# (Never commit user secrets or local appsettings)
secrets.json
.env
appsettings.Development.json
appsettings.Local.json

# Publish output
publish/
